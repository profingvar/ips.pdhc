# IPS Server — Environment Configuration
# Copy to .env and fill in values. Never commit .env to version control.

# Compose project name — #893.
#
# The authoritative pin is `name: ips` on line 1 of docker-compose.yml, which
# is why the live containers are `ips-app-1` / `ips-db-1` rather than
# `ipspdhc-*`. #893 reported this as "not pinned anywhere" after grepping for
# COMPOSE_PROJECT_NAME; the grep looked for the variable and missed the compose
# key that does the same job.
#
# It is repeated HERE because the variable OVERRIDES the file's `name:`
# (measured 2026-11-02: `name: from-the-file` in the compose file, with
# COMPOSE_PROJECT_NAME=from-the-env in the environment, resolves to
# `from-the-env`). So a blank nobody filled is a blank somebody can fill
# WRONGLY, and that is exactly how dashboard's project became `current`
# (#113) — a release swap under the wrong project name silently creates a
# second parallel compose project with colliding ports and volumes.
#
# If you change this value you must also dump and restore the database.
# `pgdata` is declared `name: ips_pgdata, external: true`, so compose does not
# own it and a project rename cannot orphan it — but only as long as nobody
# renames the volume. A wrong-direction copy between volumes during the March
# 2026 gateway->planp rename destroyed a production database irrecoverably.
COMPOSE_PROJECT_NAME=ips

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-generate-with-python3-c-import-secrets-print-secrets-token-hex-32

# Database (must use psycopg3 driver scheme)
DATABASE_URL=postgresql+psycopg://ips_user:change-me@localhost:9041/ips_db
POSTGRES_USER=ips_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ips_db

# SSO / OAuth integration
OAUTH_BASE_URL=https://sso.pdhc.se
SSO_CLIENT_ID=your-client-id
SSO_CLIENT_SECRET=your-client-secret

# Bootstrap superuser (remove BOOTSTRAP_SU_PASSWORD after first login)
BOOTSTRAP_SU_USERNAME=admin
BOOTSTRAP_SU_PASSWORD=change-me

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:9042

# Auth bypass for local development (NEVER true in production)
AUTH_DISABLED=true

# Ports
APP_PORT=9040
ADMIN_PORT=9042
