# IPS Server — Environment Configuration
# Copy to .env and fill in values. Never commit .env to version control.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-generate-with-python3-c-import-secrets-print-secrets-token-hex-32

# Database (must use psycopg3 driver scheme)
DATABASE_URL=postgresql+psycopg://ips_user:change-me@localhost:9041/ips_db
POSTGRES_USER=ips_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ips_db

# SSO / OAuth integration
OAUTH_BASE_URL=https://sso.pdhc.se
SSO_CLIENT_ID=your-client-id
SSO_CLIENT_SECRET=your-client-secret

# Bootstrap superuser (remove BOOTSTRAP_SU_PASSWORD after first login)
BOOTSTRAP_SU_USERNAME=admin
BOOTSTRAP_SU_PASSWORD=change-me

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:9042

# Auth bypass for local development (NEVER true in production)
AUTH_DISABLED=true

# Ports
APP_PORT=9040
ADMIN_PORT=9042
